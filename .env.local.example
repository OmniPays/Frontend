# Local development environment template.
# Copy to .env.local for `next dev`. Never put secrets in NEXT_PUBLIC_* variables:
# those values are compiled into browser JavaScript.

# Public client configuration
NEXT_PUBLIC_AGGREGATOR_ENABLED_MAINNET=true
NEXT_PUBLIC_AGGREGATOR_ENABLED_TESTNET=true
NEXT_PUBLIC_BACKEND_URL=https://api.soroswap.finance
NEXT_PUBLIC_DEFAULT_NETWORK=testnet
NEXT_PUBLIC_TRUSTLINE_WALLET_PUBLIC_KEY=
NEXT_PUBLIC_DIRECT_PATH_ENABLED=false
NEXT_PUBLIC_MAINNET_RPC_URL=https://soroban-rpc.mainnet.stellar.org/

# Server-only configuration (read by Next API routes)
SOROSWAP_API_URL=
SOROSWAP_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional RPC overrides for the test-token mint route
TESTNET_RPC_URL=
STANDALONE_RPC_URL=
FUTURENET_RPC_URL=

# Server-only test-token admin secret. Leave empty to disable minting.
TEST_TOKENS_ADMIN_SECRET_KEY=
